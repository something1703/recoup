# Copy to .env (or set these in your host's env / Fly.io / Render / Railway secrets).
# Never commit a real .env — it's already covered by the root .gitignore in a normal
# git init, but double-check before your first commit.

PORT=8890

# Required — the server refuses to start without this (no default fallback).
# Whatever long random string you want. TrueForge sends this back as
# `Authorization: Bearer <token>` on every call once you configure the connector
# with "header auth" — see README.md "Wire it into TrueForge".
MCP_SERVER_TOKEN=change-me-to-something-random

# Keep this "true" for all rehearsals. Only set to "false" for the take you actually
# record, and only against Stripe TEST-mode keys / a scratch Linear team. Never point
# this at production Stripe or your real Linear workspace.
DRY_RUN=true

# Required only when DRY_RUN=false.
STRIPE_SECRET_KEY=sk_test_...

# Required only when DRY_RUN=false.
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_KEY=OPS

# Required for get_customer_ltv. Connection string for the recoup_agent_readonly
# Postgres role (SELECT on customers only) from the business-data Supabase project —
# see scripts/seed-supabase.sql. Never the harness's own state database, and never
# a role with more than SELECT on customers.
CUSTOMERS_DB_URL=postgresql://recoup_agent_readonly.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Required for the recovery ledger (writes after retry_eligible_charges /
# open_recovery_ticket execute) and the /stats endpoint the cockpit reads.
# Connection string for the recoup_actions_service role (SELECT on
# dunning_policy, SELECT+INSERT on recovery_ledger) — a different role than
# CUSTOMERS_DB_URL above, on purpose: this is the server's own audit trail,
# not something the agent has any access to. See scripts/seed-supabase.sql.
RECOVERY_LEDGER_DB_URL=postgresql://recoup_actions_service.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
